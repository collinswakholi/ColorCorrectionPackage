# Compatibility manifest for tools invoking setup.py; Hatch uses pyproject.toml.
include README.md LICENSE CHANGELOG.md pyproject.toml
recursive-include docs *.md
recursive-include Images *.JPG
recursive-include ReadMe_Images *.svg
recursive-include scripts *.py
recursive-include ColorCorrectionPipeline *.py *.onnx *.md *.json *.txt
global-exclude *.pt *.pkl *.pickle *.py[cod] *.nbc *.nbi
prune tests
prune benchmarks
